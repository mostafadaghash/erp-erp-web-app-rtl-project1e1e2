COMPOSE_PROJECT_NAME=business-tech-erp-local

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_USER=convex
POSTGRES_PASSWORD=GENERATED_LOCALLY_DO_NOT_COMMIT
POSTGRES_DB=business_tech_erp_local

CONVEX_BACKEND_IMAGE=ghcr.io/get-convex/convex-backend:latest
CONVEX_DASHBOARD_IMAGE=ghcr.io/get-convex/convex-dashboard:latest
INSTANCE_NAME=business-tech-erp-local

BACKEND_BIND_HOST=127.0.0.1
PORT=3210
SITE_PROXY_PORT=3211
DASHBOARD_PORT=6791
