# Public/non-secret staging configuration
STAGING_ENVIRONMENT=staging
STAGING_BASE_URL=https://staging.example.com
STAGING_CONVEX_URL=https://example-staging.convex.cloud
STAGING_CONVEX_SITE_URL=https://example-staging.convex.site
STAGING_TARGET_CONFIRMATION=staging.example.com|example-staging
E2E_ENVIRONMENT=staging
SITE_URL=https://staging.example.com
CONVEX_SITE_URL=https://example-staging.convex.site
ALLOWED_HOSTS=staging.example.com
VITE_CONVEX_URL=https://example-staging.convex.cloud
VITE_ALLOWED_HOSTS=staging.example.com

# Name/SKU fragment for a synthetic active product seeded only in staging.
E2E_PRODUCT_QUERY=E2E-PRODUCT

# Optional Windows override. Leave blank to auto-detect Chrome or Edge.
E2E_BROWSER_EXECUTABLE=

# Dedicated non-production browser-test accounts.
# Never commit real emails or passwords.
# Configure real values as GitHub Environment secrets or in an ignored local file.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# When set explicitly, this must equal E2E_BUSINESS_FIXTURES_JSON.branchName.
# Account setup can also derive the branch from the business fixture JSON.
E2E_ACCOUNT_BRANCH_NAME=
STAGING_ACCOUNT_SETUP_CONFIRMED=
E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=
E2E_ACCOUNTANT_EMAIL=
E2E_ACCOUNTANT_PASSWORD=
E2E_SALES_EMAIL=
E2E_SALES_PASSWORD=
E2E_CUSTOMER_SERVICE_EMAIL=
E2E_CUSTOMER_SERVICE_PASSWORD=
E2E_TECHNICIAN_EMAIL=
E2E_TECHNICIAN_PASSWORD=
E2E_SHIPPING_EMAIL=
E2E_SHIPPING_PASSWORD=
E2E_VIEWER_EMAIL=
E2E_VIEWER_PASSWORD=

# Required by the full no-skip role matrix. Keep the real JSON only in an
# ignored .env.staging.local file or a GitHub Environment secret.
# The local bulk setup command instead writes the same eight accounts to the
# ignored .staging-role-accounts.json.local file without printing secrets.
E2E_REQUIRE_ALL_ROLES=true
E2E_ROLE_ACCOUNTS_JSON=

# Mutable business acceptance is opt-in and is rejected outside disposable Staging.
E2E_MUTATIONS_CONFIRMED=
E2E_BUSINESS_FIXTURES_JSON=
STAGING_FULL_RUN_CONFIRMED=
E2E_LOAD_CONFIRMED=

# Bounded Staging load defaults. The all-in-one runner still requires explicit
# acknowledgement before sending load or creating records.
LOAD_CONCURRENCY=256
LOAD_REQUESTS=25000
LOAD_P95_LIMIT_MS=2000
