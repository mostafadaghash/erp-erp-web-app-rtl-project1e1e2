{
  "name": "flex-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite --open",
    "dev:backend": "convex dev",
    "build": "vite build",
    "typecheck": "tsc -p convex --noEmit --pretty false && tsc -p . --noEmit --pretty false",
    "test": "node --test --test-concurrency=1 --experimental-strip-types tests/*.test.ts",
    "security:check": "node scripts/security-check.mjs",
    "release:preflight": "node scripts/release/preflight.mjs",
    "release:evidence:verify": "node scripts/release/verify-evidence.mjs",
    "verify": "npm run typecheck && npm test && npm run security:check && npm run build && npm run release:preflight",
    "lint": "npm run verify",
    "pretest": "node scripts/install-convex-test.mjs && npm run printing:acceptance",
    "printing:acceptance": "node scripts/printing/generate-acceptance-artifacts.mjs",
    "staging:check": "node scripts/staging-env-check.mjs",
    "test:staging-preflight": "node scripts/staging-preflight.mjs",
    "staging:accounts:setup": "node scripts/staging-account-setup.mjs",
    "staging:fixtures:setup": "node scripts/staging-fixtures-setup.mjs",
    "test:e2e-staging": "node scripts/staging-browser-e2e.mjs",
    "test:e2e-business-staging": "node scripts/staging-business-e2e.mjs",
    "test:load-staging": "node scripts/load-staging.mjs",
    "test:staging:all": "node scripts/staging-all.mjs",
    "migration:prepare": "node scripts/migration/prepare.mjs",
    "migration:verify": "node scripts/migration/verify-package.mjs",
    "migration:example": "node scripts/migration/prepare.mjs --input migration/example.input.json --output migration/output/example --fail-on-rejects --fail-on-differences && node scripts/migration/verify-package.mjs migration/output/example",
    "migration:rehearsal": "node scripts/migration/rehearsal.mjs",
    "backup:plan": "node scripts/backup/create.mjs",
    "backup:create": "node scripts/backup/create.mjs --execute",
    "backup:verify": "node scripts/backup/verify.mjs",
    "restore:plan": "node scripts/backup/restore.mjs",
    "restore:execute": "node scripts/backup/restore.mjs --execute",
    "restore:verify": "node scripts/backup/verify-drill.mjs",
    "fresh-start:audit": "node scripts/fresh-start/audit.mjs",
    "e2e:install": "npm install --no-save --package-lock=false @playwright/test@1.62.1",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:roles": "playwright test --grep @roles",
    "test:e2e:flows": "playwright test --grep @flows",
    "test:e2e:staging": "npm run staging:check && playwright test",
    "local:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/bootstrap.ps1",
    "local:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/configure.ps1",
    "local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/status.ps1",
    "local:acceptance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/acceptance.ps1",
    "local:test:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/full-suite.ps1",
    "local:test:business": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/full-suite.ps1 -SkipVerify",
    "local:up": "docker compose --env-file infra/local/runtime.env.local -f infra/local/docker-compose.yml up -d",
    "local:down": "docker compose --env-file infra/local/runtime.env.local -f infra/local/docker-compose.yml down",
    "local:frontend": "vite --mode local-server --open",
    "local:lan:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/lan-up.ps1",
    "local:lan:frontend": "vite --mode local-server-lan --host 0.0.0.0 --open",
    "backend:dev": "tsx watch server/main.ts",
    "backend:typecheck": "tsc -p server/tsconfig.json --noEmit --pretty false",
    "backend:test": "node --import tsx --test server/tests/backend-skeleton.test.ts server/tests/idempotency-service.test.ts server/tests/document-sequence-service.test.ts server/tests/posting-batch-service.test.ts server/tests/audit-service.test.ts server/tests/transactional-outbox.test.ts server/tests/error-mapper.test.ts server/tests/authentication.test.ts server/tests/role-catalog.test.ts server/tests/effective-permissions.test.ts server/tests/branch-scope.test.ts server/tests/organization-service.test.ts server/tests/system-admin-protection.test.ts server/tests/counterparty-service.test.ts server/tests/phone-normalization.test.ts server/tests/counterparty-ledger-service.test.ts",
    "backend:build": "tsc -p server/tsconfig.build.json",
    "backend:start": "node dist-server/main.js",
    "backend:verify": "npm run backend:typecheck && npm run backend:test && npm run backend:build"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.95",
    "@fastify/env": "7.0.0",
    "clsx": "^2.1.1",
    "convex": "^1.44.0",
    "fastify": "5.12.3",
    "lucide-react": "^1.11.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@sparticuz/chromium": "^149.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "~10",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "npm-run-all": "^4.1.5",
    "playwright-core": "^1.62.1",
    "postcss": "~8",
    "prettier": "^3.5.3",
    "tailwindcss": "~3",
    "tsx": "4.23.13",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
