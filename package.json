{
  "name": "flex-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite --open",
    "dev:backend": "convex dev",
    "build": "vite build",
    "typecheck": "tsc -p convex --noEmit --pretty false && tsc -p . --noEmit --pretty false",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "security:check": "node scripts/security-check.mjs",
    "verify": "npm run typecheck && npm test && npm run security:check && npm run build",
    "lint": "npm run verify",
    "pretest": "node scripts/install-convex-test.mjs",
    "staging:check": "node scripts/staging-env-check.mjs",
    "migration:prepare": "node scripts/migration/prepare.mjs",
    "migration:verify": "node scripts/migration/verify-package.mjs",
    "migration:example": "node scripts/migration/prepare.mjs --input migration/example.input.json --output migration/output/example --fail-on-rejects --fail-on-differences && node scripts/migration/verify-package.mjs migration/output/example",
    "e2e:install": "npm install --no-save --package-lock=false @playwright/test@1.55.0",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:roles": "playwright test --grep @roles",
    "test:e2e:flows": "playwright test --grep @flows",
    "test:e2e:staging": "npm run staging:check && playwright test"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.80",
    "clsx": "^2.1.1",
    "convex": "^1.24.2",
    "lucide-react": "^1.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "~10",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "npm-run-all": "^4.1.5",
    "postcss": "~8",
    "prettier": "^3.5.3",
    "tailwindcss": "~3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
